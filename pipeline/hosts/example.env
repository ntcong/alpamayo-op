# GPU host profile. Copy to pipeline/hosts/<name>.env (gitignored) and use it with `--host <name>`.
# Remote paths may start with ~ (expanded on the GPU host) or be absolute. No spaces.

# ssh target of the GPU host (name from ~/.ssh/config or user@host). Key-based login, no password prompt.
SSH_TARGET="gpu-box"

# Where the host keeps code, samples and results (runs/<name>/ is created below it).
REMOTE_BASE="~/alpamayo-eval"

# NVIDIA's alpamayo2-edge checkout with a .venv (created by edge-setup.sh / pipeline/spark-setup.sh).
NVIDIA_DIR="~/alpamayo/alpamayo2-edge"

# Extra spark/run_edge.py flags:
#   8 GB cards (RTX 2060 Super ...): "--hybrid --num-traj 1"  (vision encoder on the CPU, ~45 s/sample)
#   big GPUs:                        "--num-traj 6"
HOST_FLAGS="--hybrid --num-traj 1"

# Refuse to start when less GPU memory (MiB) is free; 0 disables the check.
MIN_FREE_MIB=6400
