# Copy to pipeline/config.env (gitignored) and edit. Sourced by pipeline/run.sh; values here override the environment.

# openpilot checkout that provides `openpilot.tools.lib.logreader` and `openpilot.common.transformations`.
# Required for the scan and prep stages (and test_geometry.py).
OPENPILOT_DIR=/path/to/openpilot

# Python 3 with numpy, av, Pillow (default: python3).
#PYTHON=/path/to/venv/bin/python

# Data root: qlogs, full segments, scan.csv, runs/<name>/ (default: data/ in this repo).
#ALPAMAYO_ROOT=data

# ssh name of the comma device, as in ~/.ssh/config (default: comma). Only read from, never written to.
#COMMA_SSH=comma

# TTF font for the ffmpeg clip overlay (default: DejaVuSans).
#FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
